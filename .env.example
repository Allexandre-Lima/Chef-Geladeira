# Copie para .env e preencha. Chave gratuita do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo principal e alternativos (usados se o principal estiver indisponível ou sem cota)
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Opcional: chave gratuita da USDA em https://fdc.nal.usda.gov/api-key-signup
# Sem ela, o projeto usa a DEMO_KEY (limite de 30 consultas por hora).
USDA_API_KEY=DEMO_KEY

# Atualização automática do prompt: analisa os feedbacks a cada N feedbacks úteis
AUTO_IMPROVE=true
AUTO_IMPROVE_THRESHOLD=3
REGRESSION_PASS_THRESHOLD=0.8
LOG_LEVEL=INFO
